# Copy this file to .env and run: docker compose up -d
# Then open http://localhost:3333 and create an account.
# Go to Settings → Security to create an access token for the Ghostfolio Agent.

COMPOSE_PROJECT_NAME=ghostfolio-local

# Redis (used by Ghostfolio; host is the compose service name)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ghostfolio-local-redis-secret

# PostgreSQL
POSTGRES_DB=ghostfolio
POSTGRES_USER=ghostfolio
POSTGRES_PASSWORD=ghostfolio-local-db-secret

# Ghostfolio app (use random strings in production)
ACCESS_TOKEN_SALT=local-salt-change-in-production
JWT_SECRET_KEY=local-jwt-secret-change-in-production

# Connection string for Ghostfolio (same credentials as above)
DATABASE_URL=postgresql://ghostfolio:ghostfolio-local-db-secret@postgres:5432/ghostfolio?connect_timeout=300&sslmode=prefer
