# =============================================================================
# Ghostfolio Agent Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# OpenAI API Key (required)
OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# LangSmith Observability
# -----------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=AgentForge
LANGSMITH_WORKSPACE_ID=your_workspace_id_here

# -----------------------------------------------------------------------------
# Ghostfolio Configuration
# -----------------------------------------------------------------------------
# Ghostfolio instance URL (self-hosted or Ghostfolio Premium)
GHOSTFOLIO_API_URL=http://localhost:3333

# Ghostfolio access token (from Settings > Security > Access Token)
GHOSTFOLIO_ACCESS_TOKEN=your_ghostfolio_access_token_here

# Use mock data for development (set to 'true' to skip real API calls)
USE_MOCK_DATA=false

# -----------------------------------------------------------------------------
# External APIs (Market Data)
# -----------------------------------------------------------------------------
# Yahoo Finance (free, no key required)
YAHOO_FINANCE_ENABLED=true

# CoinGecko API Key (optional, for higher rate limits)
COINGECKO_API_KEY=your_coingecko_api_key_here

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Environment: development, staging, production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Server configuration
HOST=0.0.0.0
PORT=8000

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=100

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
# Cache TTL in seconds (default: 5 minutes)
CACHE_TTL_SECONDS=300

# Redis configuration (optional, for distributed caching)
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Secret key for session encryption
SECRET_KEY=your_random_secret_key_here

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
